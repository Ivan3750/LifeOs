# Скопіюйте цей файл у .env і впишіть свої дані.
# .env не потрапляє в git — паролі лишаються тільки у вас і на сервері.

# --- База даних MySQL (наприклад, Aiven) ---
DB_HOST=
DB_PORT=23785
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
# true — шифроване з'єднання (для Aiven обов'язково), false — для локальної MySQL
DB_SSL=true
# Необов'язково: CA-сертифікат сервера (Aiven → Overview → CA certificate).
# Шлях до файлу (напр. ./ca.pem) або сам текст PEM. З ним сертифікат бази перевіряється повністю.
DB_CA_CERT=

# Замість окремих полів можна вказати один Service URI — він має пріоритет:
# DATABASE_URL=

# --- Вхід у дашборд ---
# Пароль, яким ви входите в дашборд з будь-якого пристрою.
APP_PASSWORD=
# Необов'язково: окремий секрет для підпису сесій. Якщо його змінити, всі пристрої вийдуть із системи.
# SESSION_SECRET=

# --- Календарі (необов'язково) ---
# Секретні iCal-посилання (.ics) через кому. Також можна додати в застосунку: Налаштування → Мої календарі.
ICAL_URLS=
