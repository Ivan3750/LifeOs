# Скопіюйте цей файл у .env і впишіть свої дані.
# .env не потрапляє в git — паролі лишаються тільки у вас і на сервері.

# --- База даних PostgreSQL (Neon, Supabase, Railway, Aiven, власний сервер…) ---
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# true — шифроване з'єднання (для хмарних баз зазвичай обов'язково), false — для локального Postgres
DB_SSL=true
# Сертифікат бази не потрібен: з'єднання шифрується без нього.
# Лише якщо хочеш додатково перевіряти сертифікат сервера (публічний CA): DB_SSL_VERIFY=true

# Замість окремих полів можна вказати один рядок підключення — він має пріоритет:
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# --- Вхід у дашборд ---
# Пароль, яким ви входите в дашборд з будь-якого пристрою.
APP_PASSWORD=
# Необов'язково: окремий секрет для підпису сесій. Якщо його змінити, всі пристрої вийдуть із системи.
# SESSION_SECRET=

# --- Календарі (необов'язково) ---
# Секретні iCal-посилання (.ics) через кому. Також можна додати в застосунку: Налаштування → Мої календарі.
ICAL_URLS=
